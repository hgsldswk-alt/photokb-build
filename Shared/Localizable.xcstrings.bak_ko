    "issue.pdfPageLimit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版每份 PDF 最多 5 页，高级版不限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The free tier supports up to 5 pages per PDF. Advanced has no page limit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版每份 PDF 最多 5 頁，進階版不限。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料版はPDFごとに最大5ページです。上位版にページ制限はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 버전은 PDF당 최대 5페이지를 지원합니다. 고급 버전은 페이지 제한이 없습니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz sürüm PDF başına en fazla 5 sayfa destekler. Gelişmiş sürümde sayfa sınırı yoktur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم الإصدار المجاني حتى ٥ صفحات لكل ملف PDF. الإصدار المتقدم بلا حد للصفحات."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатной версии до 5 страниц на PDF, в расширенной ограничений по страницам нет."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão gratuita aceita até 5 páginas por PDF. A versão avançada não tem limite de páginas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión gratuita admite hasta 5 páginas por PDF. La versión avanzada no tiene límite de páginas."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi gratis mendukung hingga 5 halaman per PDF. Versi lanjutan tidak membatasi jumlah halaman."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชันฟรีรองรับสูงสุด 5 หน้าต่อ PDF เวอร์ชันขั้นสูงไม่จำกัดจำนวนหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản miễn phí hỗ trợ tối đa 5 trang mỗi PDF. Bản nâng cao không giới hạn số trang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos sind bis zu 5 Seiten je PDF verfügbar. Die erweiterte Version hat kein Seitenlimit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version gratuite accepte jusqu’à 5 pages par PDF. La version avancée ne limite pas le nombre de pages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione gratuita consente fino a 5 pagine per PDF. La versione avanzata non ha un limite di pagine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis zijn maximaal 5 pagina’s per pdf beschikbaar. De uitgebreide versie heeft geen paginalimiet."
          }
        }
      }
    },
    "issue.invalidPixels": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效像素值：宽高各为 1–4096，合计最多 1200 万像素。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 1–4,096 pixels per side and up to 12 million pixels in total."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的像素值：寬高各為 1–4096，合計最多 1200 萬像素。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各辺は1～4,096ピクセル、合計は1,200万ピクセル以下にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 변은 1~4,096픽셀, 전체는 1,200만 픽셀 이하로 입력하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kenar 1–4.096 piksel, toplam alan en fazla 12 milyon piksel olmalıdır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل من ١ إلى ٤٠٩٦ بكسل لكل ضلع وبإجمالي لا يتجاوز ١٢ مليون بكسل."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 1 до 4096 пикселей на сторону и не более 12 млн пикселей всего."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 1 a 4.096 pixels por lado e até 12 milhões de pixels no total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce de 1 a 4096 píxeles por lado y hasta 12 millones de píxeles en total."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan 1–4.096 piksel per sisi dan maksimal 12 juta piksel secara keseluruhan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบุ 1–4,096 พิกเซลต่อด้าน และรวมไม่เกิน 12 ล้านพิกเซล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập từ 1 đến 4.096 pixel mỗi cạnh, tổng cộng tối đa 12 triệu pixel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib 1–4.096 Pixel pro Seite und höchstens 12 Millionen Pixel insgesamt ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez de 1 à 4 096 pixels par côté, pour un total de 12 millions de pixels maximum."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci da 1 a 4.096 pixel per lato e un totale massimo di 12 milioni di pixel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 1 tot 4.096 pixels per zijde in, met in totaal maximaal 12 miljoen pixels."
          }
        }
      }
    },
    "issue.pixelLimit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前像素下无法达到此 KB 上限。请提高上限或减小宽高。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These dimensions exceed the KB limit. Use a higher limit or smaller dimensions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前像素無法達到此 KB 上限。請提高上限或縮小寬高。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この寸法ではKB上限に収まりません。上限を上げるか、幅と高さを小さくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 크기로는 KB 제한에 맞출 수 없습니다. 제한을 높이거나 너비와 높이를 줄이세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu boyutlar KB sınırına sığmıyor. Sınırı artırın veya boyutları küçültün."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن بلوغ حد الكيلوبايت بهذه الأبعاد. ارفع الحد أو صغّر الأبعاد."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При этих размерах лимит в КБ недостижим. Увеличьте лимит или уменьшите размеры."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas dimensões ultrapassam o limite em KB. Aumente o limite ou reduza as dimensões."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas dimensiones superan el límite en KB. Aumenta el límite o reduce las dimensiones."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensi ini melebihi batas KB. Naikkan batas atau perkecil dimensi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดนี้เกินขีดจำกัด KB โปรดเพิ่มขีดจำกัดหรือลดขนาดภาพ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước này vượt giới hạn KB. Hãy tăng giới hạn hoặc giảm kích thước."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Abmessungen überschreiten das KB-Limit. Erhöhe das Limit oder verkleinere die Abmessungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces dimensions dépassent la limite de taille. Augmentez la limite ou réduisez les dimensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con queste dimensioni non puoi rispettare il limite in KB. Aumenta il limite o riduci le dimensioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze afmetingen overschrijden de KB-limiet. Verhoog de limiet of verklein de afmetingen."
          }
        }
      }
    }
  },
