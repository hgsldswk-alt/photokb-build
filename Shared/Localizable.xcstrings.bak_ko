          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを読み込めませんでした。ダウンロード済みの有効なファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF를 읽을 수 없습니다. 다운로드된 올바른 파일을 선택하세요."
          }
        },
        "tr": {
          "stringUnit": {
