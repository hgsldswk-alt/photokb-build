    "settings.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片和规则在本机处理。只读取所选图片，存到照片时才请求添加权限。无账号、广告或统计。购买与恢复由 App Store 处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and rules are processed on device. Only selected images are read, and add-only access is requested when saving. No accounts, ads or analytics. The App Store handles purchases and restores."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片和規則在裝置上處理。只會讀取所選圖片，儲存至照片時才要求新增權限。無帳號、廣告或統計。購買與回復由 App Store 處理。"
          }
        }
      }
    },
