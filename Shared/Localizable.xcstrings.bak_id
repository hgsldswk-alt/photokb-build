    "pixel.passport": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "护照／签证照片常用尺寸，请以提交要求为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Common for passport or visa photos. Check your submission requirements."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "護照／簽證照片常用尺寸，請依提交要求為準。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスポートやビザの写真によく使われます。提出先の条件をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여권이나 비자 사진에 자주 쓰이는 크기입니다. 제출 요건을 확인하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasaport ve vize fotoğraflarında yaygındır. Başvuru koşullarını kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقاس شائع لصور جوازات السفر والتأشيرات. تحقق من متطلبات التقديم."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частый размер фото для паспорта и визы. Уточните требования к подаче."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho comum para fotos de passaporte e visto. Confira os requisitos de envio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño habitual para fotos de pasaporte y visado. Consulta los requisitos de presentación."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran umum untuk foto paspor atau visa. Periksa syarat pengajuan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขนาดที่ใช้บ่อยสำหรับรูปหนังสือเดินทางหรือวีซ่า โปรดตรวจสอบข้อกำหนดการยื่น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước thường dùng cho ảnh hộ chiếu hoặc thị thực. Hãy kiểm tra yêu cầu nộp ảnh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gängige Größe für Pass- und Visafotos. Prüfe die Anforderungen für deinen Antrag."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille courante pour les photos de passeport et de visa. Vérifiez les critères du dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Misura comune per foto di passaporti e visti. Verifica i requisiti per la tua domanda."
          }
        },
        "nl": {
