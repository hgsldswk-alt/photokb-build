        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove password protection from this PDF first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先移除此 PDF 的密碼保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
