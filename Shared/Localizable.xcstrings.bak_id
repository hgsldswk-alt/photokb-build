    "pixel.fit": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按所填的较大值缩放长边，保留完整画面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the larger number for the long edge and keep the whole image."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依輸入的較大值縮放長邊，保留完整畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きい方の数値を長辺に使い、縦横比を保って画像全体のサイズを変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 큰 값을 긴 변에 적용하고 비율을 유지해 전체 이미지를 보존합니다."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük değeri uzun kenara uygulayın ve görselin tamamını orantılı olarak koruyun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم القيمة الأكبر للضلع الطويل، مع الحفاظ على الصورة كاملة ونسبتها."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больший размер задаёт длинную сторону. Изображение сохраняется целиком и в исходных пропорциях."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o maior valor para o lado mais longo e preserva a imagem inteira e a proporção."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el mayor valor para el lado largo y conserva la imagen completa y sus proporciones."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan nilai lebih besar untuk sisi terpanjang dan pertahankan seluruh gambar serta rasionya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ค่าที่มากกว่าเป็นด้านยาว และคงภาพทั้งภาพไว้ตามสัดส่วนเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng giá trị lớn hơn cho cạnh dài và giữ nguyên toàn bộ ảnh cùng tỷ lệ gốc."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der größere Wert gilt für die lange Seite. Das ganze Bild und sein Seitenverhältnis bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la plus grande valeur pour le côté long et conserve l’image entière et ses proportions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il valore maggiore per il lato lungo e mantiene l’intera immagine e le proporzioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de grootste waarde voor de lange kant en behoud de hele afbeelding en de verhouding."
          }
        }
      }
    },
