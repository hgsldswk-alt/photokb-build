    "issue.impossible": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个上限下无法生成可用图片。可提高上限或换一张照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usable image fits this limit. Raise the limit or choose another photo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這個上限下無法產生可用圖片。請提高上限或更換圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この上限では、使える画像を作成できません。上限を引き上げるか、別の写真を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제한에 맞는 이미지를 만들 수 없습니다. 제한을 높이거나 다른 사진을 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna imagen cabe en este límite. Sube el límite o elige otra foto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma imagem cabe neste limite. Aumente o limite ou escolha outra foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Bild passt in dieses Limit. Erhöhe das Limit oder wähle ein anderes Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image ne tient dans cette limite. Augmentez la limite ou choisissez une autre photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna immagine rientra in questo limite. Aumenta il limite o scegli un’altra foto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen afbeelding past binnen deze limiet. Verhoog de limiet of kies een andere foto."
          }
        }
      }
    },
    "issue.writeFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法写入本机文件，请检查可用空间后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t write to device storage. Check free space and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法寫入裝置，請檢查可用空間後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末に書き込めませんでした。空き容量を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 쓸 수 없습니다. 여유 공간을 확인하고 다시 시도하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaza yazılamadı. Boş alanı kontrol edip yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت الكتابة على الجهاز. تحقق من المساحة المتاحة وحاول مجددًا."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось записать файл на устройство. Проверьте свободное место и повторите попытку."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível gravar no dispositivo. Confira o espaço livre e tente novamente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar en el dispositivo. Comprueba el espacio libre y vuelve a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menulis ke perangkat. Periksa ruang kosong dan coba lagi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกลงอุปกรณ์ไม่ได้ โปรดตรวจสอบพื้นที่ว่างแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể ghi vào thiết bị. Hãy kiểm tra dung lượng trống và thử lại."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht auf dem Gerät gespeichert werden. Prüfe den freien Speicherplatz und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’écrire sur l’appareil. Vérifiez l’espace libre et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile scrivere sul dispositivo. Controlla lo spazio libero e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet naar het apparaat schrijven. Controleer de vrije ruimte en probeer het opnieuw."
          }
        }
      }
    },
