    "settings.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片和规则在本机处理。只读取所选图片，存到照片时才请求添加权限。无账号、广告或统计。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and rules are processed on device. Only selected images are read, and add-only access is requested when saving. No accounts, ads or analytics."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片和規則在裝置上處理。只會讀取所選圖片，儲存至照片時才要求新增權限。無帳號、廣告或統計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像とルールは端末内で処理します。読み込むのは選択した画像だけです。「写真」に保存するときにのみ、写真の追加を許可するよう求めます。アカウント登録、広告、利用状況の分析はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 규칙은 기기에서 처리됩니다. 선택한 이미지만 읽으며, 저장할 때는 추가 전용 권한만 요청합니다. 계정, 광고, 분석 도구가 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y reglas se procesan en el dispositivo. Solo se leen las imágenes elegidas y al guardar se pide acceso solo para añadir. Sin cuentas, anuncios ni análisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos e regras são processadas no aparelho. Só as imagens escolhidas são lidas e, ao salvar, pedimos apenas acesso para adicionar. Sem contas, anúncios ou análises."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos und Regeln werden auf dem Gerät verarbeitet. Nur ausgewählte Bilder werden gelesen, beim Sichern wird nur Hinzufügen-Zugriff angefragt. Keine Konten, Werbung oder Analyse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et les règles sont traitées sur l’appareil. Seules les images choisies sont lues ; pour enregistrer, seul l’accès en ajout est demandé. Ni compte, ni pub, ni analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto e regole sono elaborate sul dispositivo. Vengono lette solo le immagini scelte e per salvare si chiede solo l’accesso in aggiunta. Niente account, pubblicità o analisi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto's en regels worden op het apparaat verwerkt. Alleen gekozen afbeeldingen worden gelezen en bij bewaren vragen we alleen toegang om toe te voegen. Geen accounts, advertenties of analyse."
          }
        }
      }
    },
