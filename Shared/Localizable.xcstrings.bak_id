            "value": "Redimensionnement de l’image…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensionamento dell’immagine…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingsgrootte aanpassen…"
          }
