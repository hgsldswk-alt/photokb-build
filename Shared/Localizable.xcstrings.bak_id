    "issue.pdfUnreadable": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这份 PDF。请选择已下载的有效文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF could not be read. Choose a valid, downloaded file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此 PDF。請選擇有效且已下載的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFを読み込めませんでした。ダウンロード済みの有効なファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF를 읽을 수 없습니다. 다운로드된 올바른 파일을 선택하세요."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF okunamadı. İndirilmiş, geçerli bir dosya seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة ملف PDF. اختر ملفًا صالحًا تم تنزيله."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать PDF. Выберите корректный скачанный файл."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o PDF. Escolha um arquivo válido e já baixado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el PDF. Selecciona un archivo válido y descargado."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF tidak dapat dibaca. Pilih file valid yang sudah diunduh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่าน PDF ไม่ได้ โปรดเลือกไฟล์ที่ถูกต้องและดาวน์โหลดแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được PDF. Hãy chọn tệp hợp lệ đã tải xuống."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das PDF konnte nicht gelesen werden. Wähle eine gültige, heruntergeladene Datei."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce PDF. Choisissez un fichier valide et téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il PDF. Scegli un file valido già scaricato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pdf kan niet worden gelezen. Kies een geldig bestand dat is gedownload."
          }
        }
      }
    },
    "issue.pdfLocked": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先移除 PDF 的密码保护。"
