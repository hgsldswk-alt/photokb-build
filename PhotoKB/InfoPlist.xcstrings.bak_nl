    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你确认导出的 JPEG 副本存到照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the JPEG copies you choose to Photos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你確認匯出的 JPEG 副本儲存至照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したJPEGのコピーを「写真」に保存するため、写真の追加を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 JPEG 사본을 사진에 저장합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en Fotos las copias JPEG que elijas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva em Fotos as cópias JPEG que você escolher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert die ausgewählten JPEG-Kopien in Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre dans Photos les copies JPEG que vous choisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva in Foto le copie JPEG che scegli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart de gekozen JPEG-kopieën in Foto's."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan salinan JPEG yang kamu pilih ke Foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет выбранные копии JPEG в Фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğiniz JPEG kopyalarını Fotoğraflar'a kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu các bản sao JPEG bạn chọn vào Ảnh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกสำเนา JPEG ที่คุณเลือกลงในรูปภาพ"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نسخ JPEG التي تختارها في الصور."
          }
        }
      }
    }
  },
  "version": "1.0"
