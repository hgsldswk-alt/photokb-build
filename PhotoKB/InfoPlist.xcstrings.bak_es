{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片压缩到KB"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compress Photo to KB"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片壓縮到KB"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像圧縮 KB指定"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "용량 줄이기"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你确认导出的 JPEG 副本存到照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the JPEG copies you choose to Photos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你確認匯出的 JPEG 副本儲存至照片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したJPEGのコピーを「写真」に保存するため、写真の追加を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 JPEG 사본을 사진에 저장합니다."
          }
        }
      }
    }
  },
  "version": "1.0"
}
